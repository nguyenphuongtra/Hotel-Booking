# Copy to /opt/hotel-booking/backend.env on EC2 (never commit actual secrets).
NODE_ENV=production
PORT=5000
MONGO_URL=mongodb://hoteluser:REPLACE_PASSWORD@mongo:27017/hotelbooking?authSource=hotelbooking
JWT_SECRET=REPLACE_RANDOM_SECRET
REFRESH_TOKEN_SECRET=REPLACE_DIFFERENT_RANDOM_SECRET
SESSION_SECRET=REPLACE_THIRD_RANDOM_SECRET
CLIENT_URL=http://13.210.172.242
CORS_ORIGINS=http://13.210.172.242
# OAuth requires valid Google credentials and typically a registered HTTPS domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
VNP_TMNCODE=
VNP_HASHSECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://13.210.172.242/api/payments/vnpay_return
